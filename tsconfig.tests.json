{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "paths": {
            "$lib": [
                "./src/lib"
            ],
            "$lib/*": [
                "./src/lib/*"
            ],
            "$src/*": [
                "./src/*"
            ],
            "$tests/*": [
                "./tests/*"
            ]
        }
    },
    "include": [
        "tests/**/*.ts",
        "src/**/*.d.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
