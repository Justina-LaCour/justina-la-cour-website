# Canonical HTTPS origin. Set this to the production domain in Preview as well.
PUBLIC_SITE_URL=https://www.justinalacour.com

# Justina's existing Artkyt content IDs
PUBLIC_ARTKYT_PROFILE_ID=
PUBLIC_ARTKYT_WEBSITE_ID=
PUBLIC_ARTKYT_BIO_ID=
PUBLIC_ARTKYT_GALLERY_ID=

# Optional public contact and legal details. Use a quoted multiline postal address.
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_LOCATION=
PUBLIC_WEBSITE_MANAGER_NAME=
PUBLIC_WEBSITE_MANAGER_EMAIL=
PUBLIC_WEBSITE_MANAGER_ADDRESS=

# reCAPTCHA pair for the contact form
PUBLIC_RECAPTCHA_SITEKEY=
RECAPTCHA_SECRET_KEY=

# Comma-separated bare hosts for this environment. Include its exact preview hostname.
SITE_HOSTNAMES=www.justinalacour.com
# Set three distinct secrets and configure Artkyt's webhook to use ARTKYT_WEBHOOK_SECRET.
ARTKYT_WEBHOOK_SECRET=
ISR_BYPASS_TOKEN=
CRON_SECRET=

# Vercel's sanitize-html dependency bridge
NODE_OPTIONS=--experimental-require-module
